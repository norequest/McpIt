<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mcp-token-report</AssemblyName>
    <RootNamespace>McpIt.TokenReport.Tool</RootNamespace>

    <!-- Publish as a .NET global/local tool: dotnet tool install -g McpIt.TokenReport.Tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mcp-token-report</ToolCommandName>
    <PackageId>McpIt.TokenReport.Tool</PackageId>
    <Description>Offline token-cost analyzer for any MCP server. Reads a live server or a saved tools/list JSON, reports estimated per-tool and total tokens your tool definitions cost the model, and fails a CI build over a --budget. Part of McpIt.</Description>
    <PackageTags>mcp;model-context-protocol;mcp-server;tokens;token-count;llm;ai-agents;dotnet-tool;ci</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpIt.TokenReport\McpIt.TokenReport.csproj" />
  </ItemGroup>

</Project>
