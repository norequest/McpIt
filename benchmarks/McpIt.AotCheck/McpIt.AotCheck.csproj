<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- Enable all trim/AOT/single-file analyzers at BUILD TIME.
         No native AOT toolchain is required: the analyzers run as Roslyn
         diagnostics during compilation and surface IL2026/IL3050 as warnings.
         IsAotCompatible already sets the three Enable* flags below;
         they are listed explicitly so the intent is clear in code review. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!-- Promote the two key diagnostics to errors so any future AOT regression
         in the exercised helpers fails the CI build rather than emitting a silent
         warning. IL2026 = RequiresUnreferencedCode, IL3050 = RequiresDynamicCode. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\McpIt\McpIt.csproj" />
  </ItemGroup>
</Project>
